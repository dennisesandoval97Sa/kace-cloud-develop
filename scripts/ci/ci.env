# Entorno sintetico para CI. NO contiene secretos reales: todos los valores
# que en produccion serian credenciales son placeholders inertes.
# Se copia a .env en el job de tests; jest.config.js de @kace/core carga
# ../../.env, y sin el la suite falla con 'subdomain: The value cannot be null'.

# staging | production | develop
APPS_ENVIRONMENT=staging
# Nomber del servicio (en mayusculas sin espacios)
APPS_SERVICE_NAME=DEMO
# true | false - manda sobre el apps_debug del tenant. Ademas de los logs, decide si las
# respuestas de error de la API exponen detalle de diagnostico (campos Joi, mensajes de BD,
# excepciones). En produccion nunca se expone, sea cual sea este valor: el detalle va al log
# como Response::suppressedErrorDetail, buscable por request_id.
APPS_DEBUG=false
# Nivel de detalle de logs (0-3)
APPS_DEBUG_LEVEL=1
# true | false - fuerza el logging de debug ignorando el nivel del tenant
APPS_DEBUG_OVERRIDE=false
# Dominio principal
APPS_DOMAIN=kace-cloud.test
# Subdominio para API
APPS_API_SUBDOMAIN=ciapi
# Subdominio para el Frontal
APPS_ADMIN_SUBDOMAIN=ciapp
# Dominios separados por comas
APPS_ALLOWED_ORIGINS="https://ciapp.kace-cloud.test,http://localhost:5174"
# Valores separados por espacios
APPS_CONTENT_SECURITY_POLICY_DOMAINS="*.konecta.cloud *.amazoncognito.com *.amazonaws.com"
# Valores separados por comas
APPS_FRAME_ORIGINS="https://onescript.konecta.cloud"
# Certificaco del dominio, se obtiene de AWS
APPS_CERTIFICATE_DOMAIN_ARN="ADMINISTRADORES"
# Se obtiene en AWS -> Route 53 -> Hosted Zones
APPS_HOSTED_ZONE_ID="ADMINISTRADORES"
# URL del api de kace
APPS_EXECUTE_REST_HOOK_SERVICE_URL=https://ciapi.kace-cloud.test/rest-hook
# Timeout para la ejecucion de un restflow en miliseconds
APPS_TIMEOUT_REST_FLOWS_VALUE_MS=10000
# Timeout para la ejecucion de una accion desde un cronjob en miliseconds
APPS_ACTIONS_QUEUE_EXECUTOR_TIMEOUT_MS=60000
# Timeout para la cola de ejecucion de acciones en miliseconds
APPS_ACTIONS_QUEUE_EXECUTION_TIMEOUT_MS=60000
# Zona horaria
TIMEZONE="America/Bogota"
#
DB_HOST=localhost
# Host de la réplica de lectura (read/write split). Vacío = usa DB_HOST
DB_HOST_READER=localhost
DB_DATABASE=kace_test
DB_USER="ADMINISTRADORES"
DB_PASSWORD="ADMINISTRADORES"
DB_AUXILIAR_USER="ADMINISTRADORES"
DB_AUXILIAR_PASSWORD="ADMINISTRADORES"
DB_PORT=5432
DB_SCHEMA=public
# DB_TEST* Solo aplica para entorno de desarrollo
DB_TEST_HOST=localhost
# Host de la réplica de lectura en test. Vacío = usa DB_TEST_HOST
DB_TEST_HOST_READER=localhost
DB_TEST_DATABASE=kace_test
DB_TEST_USER=kace_test
DB_TEST_PASSWORD=kace_test
DB_TEST_AUXILIAR_USER=kace_test
DB_TEST_AUXILIAR_PASSWORD=kace_test
DB_TEST_NAME=kace_test
DB_TEST_PORT=5432
DB_TEST_SCHEMA=public
# Ruta alternativa al MISMO servidor postgres de test, usada solo por los tests
# *ReadRouting* de KnexRepository: debe diferir de DB_TEST_HOST como cadena para
# que #resolveReaderConnection abra un segundo pool.
# NO confundir con DB_TEST_HOST_READER, que configura la replica de lectura a
# nivel de Tenant (Tenant.buildKnexConfig) y tiene otro proposito.
DB_TEST_ROUTING_HOST=127.0.0.1
DB_TEST_ROUTING_PORT=5432
#
AWS_DYNAMODB_MULTITENANT_TABLE_ARN="ADMINISTRADORES"
# Se obtiene al ejecutar el deploy del package kace_cloud_aws_infra
AWS_APIGATEWAY_DOMAIN_NAME="ADMINISTRADORES"
# Se obtiene al ejecutar el deploy del package kace_cloud_aws_infra
AWS_APIGATEWAY_DOMAIN_NAME_ALIAS_TARGET="ADMINISTRADORES"
# Se obtiene al ejecutar el deploy del package kace_cloud_aws_infra
AWS_APIGATEWAY_DOMAIN_NAME_ALIAS_HOSTED_ZONE_ID="ADMINISTRADORES"
# Se obtiene de AWS -> Cognito -> User pools
AWS_COGNITO_USER_POOL_ID="ADMINISTRADORES"
# Se obtiene de AWS -> Cognito -> User pools -> App clients
AWS_COGNITO_APP_CLIENT_ID="ADMINISTRADORES"
# Se obtiene de AWS -> Cognito -> User pools -> {Current User Pool} -> Domain
AWS_COGNITO_URL="ADMINISTRADORES"
# Se obtiene de la cuenta de AWS
AWS_COGNITO_REGION="ADMINISTRADORES"
# Se obtiene ejecutando el comando "npm run generate-secret-key"
SECRET_KEY="EPa88hhBrdv8sBU2iIgQd80PEDnKc4B8NEnAGfrifN4="
SECRET_IV="szdBw+SmUyGURPO/tGTPdA=="
ENCRYPTION_METHOD="aes-256-cbc"
# Tiempo de expiración del JWT (formato de la librería jsonwebtoken, ej: "1h", "7d")
JWT_EXPIRES_IN=1h
# Datos de la cuenta para el uso del bucket de S3
AWS_S3_BUCKET="ADMINISTRADORES"
AWS_S3_ACCESS_KEY_ID="ADMINISTRADORES"
AWS_S3_SECRET_ACCESS_KEY="ADMINISTRADORES"
AWS_S3_REGION="ADMINISTRADORES"
# Datos de la cuenta para el uso del ANTIVIRUS
AWS_CSS_ENABLE=1
AWS_CSS_URL="ADMINISTRADORES"
AWS_CSS_USERNAME="ADMINISTRADORES"
AWS_CSS_PASSWORD="ADMINISTRADORES"
# Se obtiene de AWS -> WAF & Shield
AWS_WAF_ARN="ADMINISTRADORES"
# Se obtiene de AWS -> EC2 -> Network interfaces
AWS_EC2_VPC_ID="ADMINISTRADORES"
# Se obtiene de AWS -> EC2 -> Network interfaces
AWS_EC2_VPC_SUBNET_PRIVATE_IDS="ADMINISTRADORES"
# Se obtiene de AWS -> EC2 -> Security Groups
AWS_EC2_VPC_LAMBDA_SECURITY_GROUP_ID="ADMINISTRADORES"
# Se obtiene de AWS -> EC2 -> Security Groups -- SG existente para el worker actions-queue-executions (si se omite, el stack crea uno nuevo)
AWS_EC2_WORKER_SECURITY_GROUP_ID="ADMINISTRADORES"
# Se obtiene de AWS -> VPC -> Subnets -- Valores separdos por comas
AWS_EC2_VPC_AVAILABILITY_ZONES="ADMINISTRADORES"
# Se obtiene de AWS -> VPC -> Subnets -- Valores separdos por comas
AWS_EC2_VPC_PRIVATE_SUBNET_ROUTE_TABLE_IDS="ADMINISTRADORES"
# Se obtiene de AWS -> Amazon Location
AWS_LOCATION_IDENTITY_ID="ADMINISTRADORES"
# Se obtiene de AWS -> Amazon Location
AWS_LOCATION_INDEXNAME="ADMINISTRADORES"
# usado por la app de notificaciones robótica
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=ci@example.test
SMTP_PASS=ci-not-a-real-secret
SMTP_PASSWORD=ci-not-a-real-secret
SMTP_ENCRYPTION=tls
# true | false
SMTP_SECURE=false
SMTP_EMAIL=ci@example.test
SMTP_FROM=ci@example.test
# Solo para uso del entorno de desarrollo
MSGRAPH_ACCOUNT=ci@example.test
MSGRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
MSGRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
MSGRAPH_CLIENT_SECRET=ci-not-a-real-secret
# Solo para uso del entorno de desarrollo
GMAIL_ACCOUNT=ci@example.test
GMAIL_CLIENT_ID=ci-client-id
GMAIL_CLIENT_SECRET=ci-not-a-real-secret
GMAIL_REFRESH_TOKEN=ci-not-a-real-token
# Solo para uso del entorno de desarrollo
TEST_RECIPIENT_EMAIL=ci@example.test
# URL del api del servicio
VITE_DEV_BASE_API_URL=http://localhost:60008
# true | false - modo desarrollo del frontal
VITE_DEVELOPMENT=false
# true | false - apunta el frontal a la API local
VITE_ENABLE_LOCAL_API=false
# true | false - habilita la API mockeada del frontal
VITE_ENABLE_MOCK_API=false
# Tamaño máximo de archivo en MB para subidas
VITE_MAX_FILE_SIZE_MB=25
# true | false - desactiva el heartbeat de sesión
VITE_SESSION_HEARTBEAT_DISABLE=false
# Frecuencia en ms del heartbeat de sesión
VITE_SESSION_HEARTBEAT_FREQUENCY=60000
# URL del logo de Konecta mostrado en el frontal
VITE_URL_LOGO_KONECTA=https://ciapp.kace-cloud.test/logo.png
# Identificador del TENANT
VITE_TENANT_ID=ci-tenant
# Se obtiene de AWS -> Cognito -> User pools -> App clients
VITE_COGNITO_CLIENT_ID="ADMINISTRADORES"
# Se obtiene de AWS -> Cognito -> User pools -> {Current User Pool} -> Domain
VITE_COGNITO_URL="ADMINISTRADORES"
VITE_COGNITO_RESPONSE_TYPE=CODE
VITE_COGNITO_SCOPE=email%20openid
VITE_IDENTITY_PROVIDER=keycloak-dev
# La url del frontal {PROTOCOL}://{SUBDOMINIO}.{DOMINIO}.{EXTENSION}/auth
VITE_COGNITO_REDIRECT_URI_PROD=https://{SUBDOMINIO}.kace-cloud.com/auth
# La url del frontal {PROTOCOL}://{SUBDOMINIO}.{DOMINIO}.{EXTENSION}/logout
VITE_COGNITO_LOGOUT_URI_PROD=https://ciapp.kace-cloud.test/logout
# Solo para uso del entorno de desarrollo. La url del frontal {PROTOCOL}://{SUBDOMINIO}.{DOMINIO}.{EXTENSION}/auth
VITE_COGNITO_REDIRECT_URI_DEV=http://localhost:5174/
# Solo para uso del entorno de desarrollo. La url del frontal {PROTOCOL}://{SUBDOMINIO}.{DOMINIO}.{EXTENSION}/logout
VITE_COGNITO_LOGOUT_URI_DEV=http://localhost:5174/logout
# URL de origen permitido para el iframe de one-script necesario para retomar el flujo de trabajo desde kace
VITE_ONESCRIPT_URL_PRO="https://onescript.konecta.cloud"
# URL del formulario de one-script pára la agenda
VITE_ONESCRIPT_DIARY_URL=https://ciapp.kace-cloud.test/diary
# ID del formulario de one-script pára la agenda
VITE_ONESCRIPT_AGENDA_ID=ci-agenda
# Se obtiene de AWS -> Amazon Location Service
VITE_AWS_LOCATION_REGION="ADMINISTRADORES"
# Se obtiene de AWS -> Amazon Location Service
VITE_AWS_LOCATION_APIKEY="ADMINISTRADORES"
# Se obtiene de AWS -> Amazon Location Service
VITE_AWS_LOCATION_NAMEMAP="ADMINISTRADORES"
# Zona Horario del servicio
VITE_TIMEZONE="America/Bogota"
#Configuracion Job "minutos, horas, dia_del_mes, mes, dia_semana, año"
IMPORT_CRON_EXPRESSION="0/1 * * * ? *"
# Cantidad de procesos a ejecutar en paralelo para los despliegues
BASH_PARALLEL_PROCESS=4
# Solo para uso del entorno de desarrollo
TEST_E2E_USERNAME=ci@example.test
# Solo para uso del entorno de desarrollo
TEST_E2E_PASSWORD=ci-not-a-real-secret
# Se obtiene de AWS -> Amazon SQS Queues
AWS_SQS_EVENTS_QUEUE_ARN="ADMINISTRADORES"
# Se obtiene de AWS -> Amazon EventBridge -> Event Buses
AWS_EVENTBRIDGE_EVENT_BUS_ARN="ADMINISTRADORES"
# Se obtiene de AWS -> Amazon EventBridge -> Event Buses
AWS_EVENTBRIDGE_EVENT_BUS_URL="ADMINISTRADORES"
# Se obtiene de AWS -> Amazon SQS Queues
AWS_SQS_EVENTS_QUEUE_URL="ADMINISTRADORES"
AWS_SQS_REGION="us-east-1"
# Se obtiene de AWS -> Amazon SQS Queues
AWS_CASES_EVENTS_QUEUE_ARN="ADMINISTRADORES"
# Se obtiene de AWS -> Amazon SQS Queues (URL de la cola)
AWS_CASES_EVENTS_QUEUE_URL="ADMINISTRADORES"
# Se obtiene de AWS -> Amazon SQS Queues
AWS_ACTION_JOBS_EVENTS_QUEUE_ARN="ADMINISTRADORES"
# Se obtiene de AWS -> Amazon SQS Queues (URL de la cola)
AWS_ACTION_JOBS_EVENTS_QUEUE_URL="ADMINISTRADORES"
# Se obtiene de AWS -> Amazon SQS Queues
AWS_AUTOMATED_ACTIONS_EVENTS_QUEUE_ARN="ADMINISTRADORES"
# Se obtiene de AWS -> Amazon SQS Queues (URL de la cola)
AWS_AUTOMATED_ACTIONS_EVENTS_QUEUE_URL="ADMINISTRADORES"
# Se obtiene de AWS -> Amazon SQS Queues
AWS_WS_REST_EVENTS_QUEUE_ARN="ADMINISTRADORES"
# Se obtiene de AWS -> Amazon SQS Queues (URL de la cola)
AWS_WS_REST_EVENTS_QUEUE_URL="ADMINISTRADORES"
# Se obtiene de AWS -> Amazon SQS Queues
AWS_CASE_POST_PROCESSING_EVENTS_QUEUE_ARN="ADMINISTRADORES"
# Se obtiene de AWS -> Amazon SQS Queues (URL de la cola)
AWS_CASE_POST_PROCESSING_QUEUE_URL="ADMINISTRADORES"
# Se obtiene de AWS -> Amazon SQS Queues (cola de eventos de reports)
AWS_REPORTS_EVENTS_QUEUE_ARN="ADMINISTRADORES"
# Se obtiene de AWS -> Amazon SQS Queues (URL de la cola de reports)
AWS_REPORTS_EVENTS_QUEUE_URL="ADMINISTRADORES"
# Prefijo del bucket S3 donde se guardan los reportes generados
REPORTS_S3_PREFIX=ci-reports
# ROBOTICA Notificaciones separado por comas
ROBOTICA_ALERT_RECIPIENTS=ci@example.test
# Esquema de BD que consulta la app de notificaciones robótica
ROBOTICA_DB_SCHEMA=public
# Umbral en minutos para disparar alertas de robótica
ROBOTICA_THRESHOLD_MINUTES=30
ACTION_FROZEN_CONDITION_CONTEXT_ENABLED=false
# true | false - activa el prefiltro SQL en la ejecución de colas de acciones
ACTION_QUEUE_SQL_PREFILTER_ENABLED=false
# true | false - activa el prefiltro SQL en la asignación automatizada de casos
AUTOMATED_ASSIGNMENT_SQL_PREFILTER_ENABLED=false
# SQL injection guard mode: "enforce" (default, blocks on dictionary match) | "observe" (detects + logs/metric, non-blocking)
# Global: this value is injected at synth into every KApiStack service (all apps/apiv1). Single source of truth.
SQL_GUARD_MODE=observe
# Allow updating a resolved case (fecha_resolucion set) via the cases actionUpdateWithAux endpoint.
# "true" bypasses the "already resolved" 403 guard on CaseUpdater + AuxCasesUpdater, and skips SLA recalculation
# and domain-event publishing for the resolved-case path. "false" (default) keeps the current behavior.
# Injected at synth only into the cases Lambda (apps/apiv1/kace_cloud_api_cases).
ALLOW_UPDATE_CLOSED_CASE=false
# Channel Hub: máximo de bytes del body externo que se descarga/almacena (default 10MB)
# Sin valor: el codigo hace `process.env.X ?? default`, y ?? NO cubre la cadena
# vacia -> Number("") = 0 y todo cuerpo "excede 0 bytes". Se deja el default
# explicito (10 MB / 8 KB) en vez de una clave vacia.
CHANNEL_HUB_EXTERNAL_BODY_MAX_BYTES=10485760
# Channel Hub: máximo de caracteres del preview del body (default 8192)
CHANNEL_HUB_BODY_PREVIEW_MAX_CHARS=8192
# URL destino del proxy de la API para el frontend (vite.config)
VITE_TARGET_API_URL=http://localhost:60008
AUTOMATED_ASSIGNMENT_CANDIDATE_HARD_CAP=2000
AUTOMATED_ASSIGNMENT_CANDIDATE_SLACK_FACTOR=3
CSP_STRICT=true
