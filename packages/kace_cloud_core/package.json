{
    "name": "@kace/core",
    "version": "1.26.1",
    "description": "",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "tests": "node --experimental-vm-modules --max-old-space-size=6144 node_modules/jest/bin/jest.js --maxWorkers=${JEST_MAX_WORKERS:-6} --shard=${JEST_SHARD:-1/1}",
        "test:ctx": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
        "test:coverage": "node --experimental-vm-modules --max-old-space-size=6144 node_modules/jest/bin/jest.js --maxWorkers=${JEST_MAX_WORKERS:-6} --coverage",
        "test:baseline": "NODE_OPTIONS=--max-old-space-size=6144 node --experimental-vm-modules node_modules/jest/bin/jest.js --maxWorkers=${JEST_MAX_WORKERS:-6} --json --outputFile=jest-baseline.json",
        "test:diagnose": "NODE_ENV=diagnostic NODE_OPTIONS=--max-old-space-size=6144 node --experimental-vm-modules node_modules/jest/bin/jest.js --reporters=default --reporters=./tests/support/diagnosticReporter.cjs --maxWorkers=6",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "uuid": "pnpm exec uuid v4",
        "version:patch": "pnpm version patch -m \"Upgrade to %s\" && git push --follow-tags",
        "version:minor": "pnpm version minor -m \"Upgrade to %s\" && git push --follow-tags",
        "version:major": "pnpm version major -m \"Upgrade to %s\" && git push --follow-tags",
        "version:prepatch": "pnpm version prepatch -m \"Upgrade to %s\" && git push --follow-tags",
        "version:preminor": "pnpm version preminor -m \"Upgrade to %s\" && git push --follow-tags",
        "version:premajor": "pnpm version premajor -m \"Upgrade to %s\" && git push --follow-tags",
        "prepare": "husky"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
