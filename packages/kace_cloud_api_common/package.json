{
    "name": "@kace/api-common",
    "version": "1.26.1",
    "main": "src/index.js",
    "type": "module",
    "scripts": {
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles --forceExit --coverage",
        "clean": "rm -rf node_modules/ pnpm-lock.yaml package-lock.json",
        "version:patch": "pnpm version patch -m \"Upgrade to %s\" && git push --follow-tags",
        "version:minor": "pnpm version minor -m \"Upgrade to %s\" && git push --follow-tags",
        "version:major": "pnpm version major -m \"Upgrade to %s\" && git push --follow-tags",
        "version:prepatch": "pnpm version prepatch -m \"Upgrade to %s\" && git push --follow-tags",
        "version:preminor": "pnpm version preminor -m \"Upgrade to %s\" && git push --follow-tags",
        "version:premajor": "pnpm version premajor -m \"Upgrade to %s\" && git push --follow-tags",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "author": "",
    "license": "ISC",
    "description": "",
    "dependencies": {
        "@aws-sdk/client-lambda": "^3.700.0",
        "@kace/core": "workspace:*",
        "@kace/error-codes": "workspace:*",
        "@kace/database": "workspace:*",
        "aws-cdk-lib": "^2.185.0",
        "aws-jwt-verify": "^5.1.1",
        "axios": "^1.7.9",
        "constructs": "^10.0.0",
        "joi": "^17.13.3",
        "jsonwebtoken": "^9.0.2",
        "knex": "^3.1.0",
        "lru-cache": "^11.2.4",
        "uuid": "^11.0.3",
        "jwt-decode": "^4.0.0",
        "@aws-sdk/client-eventbridge": "^3.985.0",
        "@aws-sdk/client-sqs": "^3.985.0"
    },
    "devDependencies": {
