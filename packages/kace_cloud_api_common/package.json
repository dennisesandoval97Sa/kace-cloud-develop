        "aws-cdk": "^2.1005.0",
        "chance": "^1.1.12",
        "conventional-changelog-cli": "^5.0.0",
        "dotenv": "^16.4.7",
        "jest": "^29.7.0",
        "prettier": "^3.3.3",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "typescript": "~5.6.3"
    }
