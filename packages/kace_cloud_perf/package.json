{
    "name": "@kace/perf",
    "version": "1.26.1",
    "private": true,
    "type": "module",
    "description": "Load testing baseline framework for kace_cloud apiv1 services",
    "scripts": {
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "users:bootstrap": "bash auth/bootstrap-users.sh",
        "users:register": "bash auth/register-users.sh",
        "tokens:generate": "node --env-file=.env.perf auth/token-pool-generator.mjs",
        "tokens:refresh": "node --env-file=.env.perf auth/refresh-tokens.mjs",
        "data:extract-ids": "node --env-file=.env.perf data/data-pool/extract-ids.mjs",
        "anonymize:extract": "bash data/anonymizer/extract.sh",
        "anonymize:run": "node --env-file=.env.perf data/anonymizer/anonymize.mjs",
        "anonymize:load": "bash data/anonymizer/load.sh",
        "baseline:run": "node --env-file=.env.perf runner/run-baseline.mjs",
        "count:load": "set -a && . ./.env.perf && set +a && k6 run --dns policy=onlyIPv4 scenarios/cases/count.js",
        "dashboard:load": "set -a && . ./.env.perf && set +a && k6 run --dns policy=onlyIPv4 scenarios/cases/dashboard-counts.js",
        "endpoints:import": "node runner/import-postman.mjs --collection \"../../tmp/Kace API.postman_collection.json\" --services-config runner/services-mapping.json --out runner/endpoints/",
        "scenarios:generate": "node runner/generate-scenarios.mjs --endpoints-dir runner/endpoints --scenarios-dir scenarios",
        "report:summarize": "node reporter/summarize.mjs",
        "compare:f1-vs-f2": "node reporter/compare.mjs ../../.claude/doc/perf/baselines/2026-05-07-f1-read"
    },
    "dependencies": {
        "@aws-sdk/client-cognito-identity-provider": "^3.600.0",
        "@faker-js/faker": "^10.5.0",
        "pg": "^8.12.0"
    },
    "devDependencies": {
        "@kace/eslint-config": "workspace:*",
        "@kace/prettier_config": "workspace:*",
        "@types/jest": "^29.5.12",
        "@types/node": "20.14.9",
        "eslint": "^8.0.1",
        "jest": "^29.7.0"
    }
}
