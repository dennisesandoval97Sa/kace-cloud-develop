{
    "service": "case-attachments",
    "postmanFolder": "Case attachments",
    "endpoints": [
        {
            "id": "view-list",
            "method": "GET",
            "path": "/case-attachments",
            "requiresId": false
        },
        {
            "id": "view-by-id",
