            "method": "POST",
            "path": "/case-attachments/search",
            "requiresId": false,
            "body": {
                "filter": [
                    {
                        "field": "description",
                        "operator": "like",
                        "value": "description example",
                        "type": "AND"
                    },
                    {
                        "field": "description",
                        "operator": "like",
                        "value": "description example",
                        "type": "AND"
                    }
                ],
                "limit": 10,
                "offset": 0
            }
        }
    ]
}
