{
    "service": "one-script",
    "postmanFolder": "One Script",
    "endpoints": [
        {
            "id": "view-list",
            "method": "GET",
            "path": "/one_script",
            "requiresId": false
        },
        {
            "id": "view-by-id",
            "method": "GET",
            "path": "/one_script/{id}",
            "requiresId": true
        },
        {
            "id": "search",
            "method": "POST",
            "path": "/one_script/search",
            "requiresId": false,
            "body": {
                "filter": [
                    {
                        "field": "name",
                        "operator": "like",
                        "value": "example name",
                        "type": "AND"
                    },
                    {
                        "field": "name",
                        "operator": "like",
                        "value": "example name",
                        "type": "AND"
                    }
                ],
                "limit": 10,
                "offset": 0
            }
        }
    ]
}
