{
    "name": "@kace/asistencia-notificaciones-robotica",
    "version": "1.26.1",
    "bin": {
        "asistencia_notificaciones_robotica": "bin/asistencia_notificaciones_robotica.js"
    },
    "scripts": {
        "build": "tsc",
        "watch": "tsc -w",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
        "cdk": "cdk",
        "cdk:synth": "rm -rf cdk.out && cdk synth",
        "cdk:single-deploy": "cdk deploy --require-approval never",
        "predeploy:audit": "pnpm audit --omit=dev",
        "eslint-check": "eslint .",
        "eslint-fix": "eslint --fix .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "cdk:clean": "rm -rf cdk.out"
    },
    "devDependencies": {
        "@kace/eslint-config": "workspace:*",
        "@kace/prettier_config": "workspace:*",
        "@types/jest": "^29.5.12",
        "@types/node": "22.5.4",
        "aws-cdk": "^2.1005.0",
        "dotenv": "^16.4.7",
        "jest": "^29.7.0",
        "prettier": "^3.3.3",
        "ts-node": "^10.9.2",
        "typescript": "~5.6.2"
    },
    "dependencies": {
        "@kace/aws-infra": "workspace:*",
        "aws-cdk-lib": "^2.185.0",
        "constructs": "^10.0.0",
        "knex": "^3.1.0",
        "nodemailer": "^6.10.0",
        "pg": "^8.16.3",
        "source-map-support": "^0.5.21"
    }
}
