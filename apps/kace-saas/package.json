{
    "name": "kace-sass",
    "version": "1.26.1",
    "bin": {
        "stack": "bin/stack.ts"
    },
    "scripts": {
        "clean": "rm -rf node_modules/ package-lock.json",
        "dev": "vite --port 5174",
        "dev:host": "vite --host",
        "e2e:auth": "playwright test e2e/auth.setup.js --config=playwright.config.js --headed --project=setup",
        "e2e": "playwright test --config=playwright.config.js --project=chromium",
        "e2e:headed": "playwright test --config=playwright.config.js --project=chromium --headed",
        "build": "vite build",
        "lint": "eslint . ",
        "preview": "vite preview",
        "test": "vitest",
        "test:coverage": "vitest --coverage",
        "tsc-build": "tsc",
        "tsc-watch": "tsc -w",
        "cdk": "cdk",
        "cdk:synth": "rm -rf cdk.out && cdk synth",
        "cdk:deploy": "vite build && cdk deploy --require-approval never",
        "cdk:clean": "rm -rf cdk.out",
        "watch": "tsc -w",
        "validate-translations": "node validate-translations.js src/locale/en.json src/locale/es.json",
        "prepare": "husky",
        "prettier-check": "prettier --check .",
        "eslint-check": "eslint .",
        "kace": "node ./scripts/generateFeature.js",
        "build:analyze": "ANALYZE=true vite build"
    },
    "workspaces": [
        "./common/validators",
        "./common/plugins"
    ],
