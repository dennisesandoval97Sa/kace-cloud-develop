{
    "name": "@kace/api-event-processor",
    "version": "1.26.1",
    "bin": {
        "event-processor": "bin/event-processor.js"
    },
    "scripts": {
        "build": "tsc",
        "watch": "tsc -w",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
        "clean": "rm -rf node_modules/ pnpm-lock.yaml package-lock.json",
        "cdk": "cdk",
        "cdk:synth": "rm -rf cdk.out && cdk synth",
        "cdk:deploy": "cdk deploy --require-approval never --force",
        "cdk:clean": "rm -rf cdk.out",
        "eslint-check": "eslint .",
        "eslint-fix": "eslint --fix .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@aws-sdk/client-cloudformation": "^3.1059.0",
        "@aws-sdk/client-dynamodb": "^3.1063.0",
        "@aws-sdk/client-lambda": "^3.962.0",
        "@aws-sdk/client-sqs": "^3.985.0",
        "@jest/globals": "^29.7.0",
        "@kace/prettier_config": "workspace:*",
        "@types/jest": "^29.5.12",
        "@types/node": "20.14.9",
        "aws-cdk": "^2.1005.0",
        "jest": "^29.7.0",
        "prettier": "^3.3.3",
        "ts-jest": "^29.1.5",
        "ts-node": "^10.9.2",
        "typescript": "~5.5.3"
    },
    "dependencies": {
        "@kace/api-common": "workspace:*",
        "@kace/aws-infra": "workspace:*",
        "@kace/core": "workspace:*",
        "@kace/eslint-config": "workspace:*",
        "aws-cdk-lib": "^2.185.0",
        "constructs": "^10.0.0",
        "knex": "^3.1.0",
        "pg-query-stream": "^4.16.0",
        "@aws-sdk/lib-storage": "^3.1063.0",
        "source-map-support": "^0.5.21"
    }
}
