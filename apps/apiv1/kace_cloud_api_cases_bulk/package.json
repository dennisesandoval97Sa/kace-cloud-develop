{
    "name": "@kace/api-cases-bulk",
    "version": "1.26.1",
    "bin": {
        "cases_bulk": "bin/cases_bulk.js"
    },
    "scripts": {
        "build": "tsc",
        "watch": "tsc -w",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
        "test:e2e": "CASES_BULK_E2E=true node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
        "cdk": "cdk",
        "api": "cdk synth && sam local start-api -t cdk.out/DEVAPICasesBulkStack.template.json --docker-network kace_cloud_main_global-network --port 60096",
        "cdk:synth": "rm -rf cdk.out && cdk synth",
        "cdk:deploy": "cdk deploy --require-approval never",
        "version:patch": "pnpm version patch -m \"Upgrade to %s\" && git push --follow-tags",
        "version:minor": "pnpm version minor -m \"Upgrade to %s\" && git push --follow-tags",
        "version:major": "pnpm version major -m \"Upgrade to %s\" && git push --follow-tags",
        "predeploy:audit": "pnpm audit --omit=dev",
        "eslint-check": "eslint .",
        "eslint-fix": "eslint --fix .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "cdk:clean": "rm -rf cdk.out"
    },
    "devDependencies": {
        "@kace/prettier_config": "workspace:*",
        "@types/jest": "^29.5.14",
        "@types/node": "22.7.9",
        "aws-cdk": "^2.1005.0",
        "chance": "^1.1.12",
        "dotenv": "^16.4.7",
        "jest": "^29.7.0",
        "prettier": "^3.3.3",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "typescript": "~5.6.3"
    },
    "dependencies": {
        "@kace/api-common": "workspace:*",
        "@kace/aws-infra": "workspace:*",
        "@kace/core": "workspace:*",
        "@kace/database": "workspace:*",
        "@kace/error-codes": "workspace:*",
        "@kace/eslint-config": "workspace:*",
        "aws-cdk-lib": "^2.185.0",
        "constructs": "^10.0.0",
        "joi": "^17.13.3",
        "pg": "^8.16.3"
    }
}
