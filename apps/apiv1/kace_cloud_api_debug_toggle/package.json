{
    "name": "@kace/api-debug-toggle",
    "version": "1.26.1",
    "bin": {
        "debug-toggle": "bin/debug-toggle.js"
    },
    "scripts": {
        "build": "tsc",
        "watch": "tsc -w",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
        "cdk": "cdk",
        "api": "pnpm run cdk:synth && sam local start-api -t cdk.out/DEVELOPMENTDebugToggleStack.template.json --docker-network kace_cloud_main_global-network --port 60099",
        "cdk:synth": "rm -rf cdk.out && cdk synth",
        "cdk:deploy": "cdk deploy --require-approval never",
        "version:patch": "pnpm version patch -m \"Upgrade to %s\" && git push --follow-tags",
        "version:minor": "pnpm version minor -m \"Upgrade to %s\" && git push --follow-tags",
        "version:major": "pnpm version major -m \"Upgrade to %s\" && git push --follow-tags",
        "predeploy:audit": "pnpm audit --omit=dev",
        "eslint-check": "eslint .",
        "eslint-fix": "eslint --fix .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "cdk:clean": "rm -rf cdk.out"
    },
    "devDependencies": {
        "@babel/core": "^7.26.0",
        "@babel/preset-env": "^7.26.0",
        "@kace/prettier_config": "workspace:*",
        "@types/jest": "^29.5.14",
        "@types/node": "22.7.9",
        "aws-cdk": "^2.1005.0",
        "babel-jest": "^29.7.0",
        "chance": "^1.1.12",
        "dotenv": "^16.4.7",
        "jest": "^29.7.0",
        "prettier": "^3.3.3",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "typescript": "~5.6.3"
    },
    "dependencies": {
        "@aws-sdk/client-cloudformation": "^3.700.0",
        "@aws-sdk/client-dynamodb": "^3.600.0",
        "@aws-sdk/client-lambda": "^3.700.0",
        "@aws-sdk/client-scheduler": "^3.700.0",
        "@aws-sdk/lib-dynamodb": "^3.600.0",
        "@kace/api-common": "workspace:*",
        "@kace/aws-infra": "workspace:*",
        "@kace/core": "workspace:*",
        "@kace/database": "workspace:*",
        "@kace/eslint-config": "workspace:*",
        "@kace/schemabuilder": "workspace:*",
        "aws-cdk-lib": "^2.185.0",
        "axios": "^1.7.9",
        "constructs": "^10.0.0",
        "joi": "^17.13.3",
        "jsonwebtoken": "^9.0.2",
        "pg": "^8.16.3",
        "uuid": "^11.0.3"
    }
}
