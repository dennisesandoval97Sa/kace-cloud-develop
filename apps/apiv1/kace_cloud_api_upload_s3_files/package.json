{
    "name": "@kace/api-upload-s3-files",
    "version": "1.26.1",
    "bin": {
        "upload_s3_files": "bin/upload_s3_files.js"
    },
    "scripts": {
        "build": "tsc",
        "watch": "tsc -w",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
        "cdk": "cdk",
        "api": "cdk synth && sam local start-api -t cdk.out/DEVAPIUploadS3FilesStack.template.json --docker-network kace_cloud_main_global-network --port 60034",
        "predeploy:audit": "pnpm audit --omit=dev",
        "cdk:deploy": "cdk deploy --require-approval never",
        "eslint-check": "eslint .",
        "eslint-fix": "eslint --fix .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "cdk:clean": "rm -rf cdk.out"
    },
    "devDependencies": {
        "@kace/prettier_config": "workspace:*",
        "@types/jest": "^29.5.12",
        "@types/node": "20.14.9",
        "aws-cdk": "^2.1005.0",
        "chance": "^1.1.12",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.5",
        "ts-node": "^10.9.2",
        "typescript": "~5.5.3",
        "prettier": "^3.3.3"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.723.0",
        "@kace/api-common": "workspace:*",
        "@kace/aws-infra": "workspace:*",
        "@kace/core": "workspace:*",
        "@kace/database": "workspace:*",
        "@kace/eslint-config": "workspace:*",
        "aws-cdk-lib": "^2.185.0",
        "axios": "^1.7.9",
        "constructs": "^10.0.0",
        "joi": "^17.13.3",
        "pg": "^8.16.3",
        "source-map-support": "^0.5.21",
        "uuid": "^11.0.3"
    }
}
