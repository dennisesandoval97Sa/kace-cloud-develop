{
  "name": "onescript-plugin-tutorial",
  "version": "1.26.1",
  "description": "Tutorial for OneScript plugin development",
  "main": "src/index.js",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "create:plugin": "node scripts/create-plugin.js",
    "create:component": "node scripts/create-component.js",
    "watch-dev": "vite --mode=dev",
    "watch-prd": "vite --mode=prd",
    "build-dev": "vite build --mode=dev",
    "build-prd:kace": "cross-env OS_PLUGIN_NAME=kace vite build --mode=prd",
    "test": "vitest .",
    "serve": "vite preview",
    "lint": "eslint . --ext .js,.jsx",
    "format": "prettier --write .",
    "docs:services-jsdoc": "node scripts/docs/generate-services-jsdoc.js",
    "docs:jsdoc": "node scripts/docs/extract-jsdoc.js"
  },
  "author": "konecta",
  "license": "ISC",
  "dependencies": {
    "@formio/react": "^5.2.4-rc.3",
    "@kace/error-codes": "workspace:*",
    "@kace/schemabuilder": "workspace:*",
    "axios": "^1.12.2",
    "clientjs": "^0.2.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.4.17",
    "formiojs": "^4.14.12",
    "joi": "^17.13.3",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.546.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-speech-recognition": "^4.0.1",
    "sweetalert2": "^11.26.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@eslint/js": "^9.37.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "vite": "^6.0.3",
    "vite-plugin-externals": "^0.6.2",
    "vitest": "^3.2.4"
  }
}
