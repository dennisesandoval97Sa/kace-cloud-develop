# Todas las variables de entorno necesitan empezar por un prefijo
# La lista de prefijos puede ser configurada en `vite.config.js`
# en la variable `envPrefixes`. Actualmente los prefijos disponibles son:
# VITE_ (usado por el provio vite, requerida),
# OS_ (comunes a todos los plugins, opcional),
# EXAMPLE_ (exclusivas del plugin `example`, opcional).
OS_ENV_VAR="default value"
OS_API_TEST="https://jsonplaceholder.typicode.com/todos/1"
EXAMPLE_ENV_VAR="example environment variable value"

# Kace plugin — mocks HTTP sin backend (ver src/plugins/kace/mocks/kaceHttpMocks.js)
# VITE_MOCK_HTTP=true
# o solo el mock de sub-cases/search incluido por defecto:
# VITE_MOCK_SUBCASES_SEARCH=true
